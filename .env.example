# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Security (server-only)
BSN_ENCRYPTION_KEY=base64_or_hex_32_byte_key
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Email
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=FinTax <notifications@example.com>

# App
# Public origin used for canonical URLs, sitemap entries, and metadata images.
# Keep this aligned with the deployed origin outside local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK_NOTIFICATIONS=0
ALLOWED_ORIGINS=http://localhost:3000
