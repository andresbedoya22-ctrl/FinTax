# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional operational override for docflow bootstrap/backfill/E2E.
# Use these when you need to validate staging against a different Supabase project
# without changing the local app runtime variables above.
DOCFLOW_SUPABASE_URL=https://your-staging-project-ref.supabase.co
DOCFLOW_SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Security (server-only)
BSN_ENCRYPTION_KEY=base64_or_hex_32_byte_key
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Email
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=FinTax <notifications@example.com>

# App
# Public origin used for canonical URLs, sitemap entries, and metadata images.
# Keep this aligned with the deployed origin outside local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK_NOTIFICATIONS=0
ALLOWED_ORIGINS=http://localhost:3000

# Staging smoke / parity validation
STAGING_URL=https://staging.example.com
STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your_staging_anon_key

# Optional: enable migrations parity checks in `pnpm smoke:staging`
STAGING_SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key
PROD_SUPABASE_URL=https://your-prod-project-ref.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=your_prod_service_role_key
STAGING_STRIPE_KEY=sk_test_staging_xxx
PROD_STRIPE_KEY=sk_live_prod_xxx
STAGING_BSN_KEY=staging_bsn_key_material
PROD_BSN_KEY=prod_bsn_key_material
